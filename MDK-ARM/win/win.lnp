--cpu Cortex-M3
"win\startup_stm32f103xb.o"
"win\main.o"
"win\gpio.o"
"win\dma.o"
"win\usart.o"
"win\stm32f1xx_it.o"
"win\stm32f1xx_hal_msp.o"
"win\stm32f1xx_hal_gpio_ex.o"
"win\stm32f1xx_hal_tim.o"
"win\stm32f1xx_hal_tim_ex.o"
"win\stm32f1xx_hal_uart.o"
"win\stm32f1xx_hal.o"
"win\stm32f1xx_hal_rcc.o"
"win\stm32f1xx_hal_rcc_ex.o"
"win\stm32f1xx_hal_gpio.o"
"win\stm32f1xx_hal_dma.o"
"win\stm32f1xx_hal_cortex.o"
"win\stm32f1xx_hal_pwr.o"
"win\stm32f1xx_hal_flash.o"
